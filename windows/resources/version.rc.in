#include <windows.h>

1 VERSIONINFO
FILEVERSION @BLINKREST_VERSION_MAJOR@,@BLINKREST_VERSION_MINOR@,@BLINKREST_VERSION_PATCH@,0
PRODUCTVERSION @BLINKREST_VERSION_MAJOR@,@BLINKREST_VERSION_MINOR@,@BLINKREST_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "fynxiu\0"
            VALUE "FileDescription", "Blink Rest\0"
            VALUE "FileVersion", "@BLINKREST_VERSION@\0"
            VALUE "InternalName", "BlinkRest\0"
            VALUE "OriginalFilename", "BlinkRest.exe\0"
            VALUE "ProductName", "Blink Rest\0"
            VALUE "ProductVersion", "@BLINKREST_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
